[TEMPLATE]
# Copy this file to .env and add your real values. Never commit .env.
#
# =========================== Local CLI =====================================
# Groq API key for the local agent. Get one at https://console.groq.com/
# (Also used server-side by the API so production keys never reach the CLI.)
GROQ_API_KEY=

# ====================== Server-side providers (Model Router) ===============
# The server routes /api/provider through a fallback chain. Each provider is
# included only when its key is configured. Default order (see
# src/agents/modelRouter.ts, overridable with ZEESH_SERVER_ROUTING):
#   1. Groq (GROQ_API_KEY)
#   2. NVIDIA NIM (NVIDIA_API_KEY)
#   3. Gemini (GEMINI_API_KEY)   — default model gemini-3.1-flash-lite
#   4. MiniMax (MINIMAX_API_KEY) — default model MiniMax-M3
# SERVER-SIDE ONLY — the CLI never reads or sends these values.
#
# Groq API key (also the local agent key) — declared above (GROQ_API_KEY).
# https://console.groq.com/
#
# NVIDIA NIM API key (https://build.nvidia.com → your API key).
# NVIDIA_API_KEY=

# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey).
# Server-side fallback provider. Default model: gemini-3.1-flash-lite.
# GEMINI_API_KEY=

# MiniMax API key (https://platform.minimax.io → Account Management → API Keys).
# Server-side fallback provider (last in the chain). Default model: MiniMax-M3.
# MINIMAX_API_KEY=

# (Optional) DeepSeek API key — included in the chain when set.
# DEEPSEEK_API_KEY=

# Override the server-side routing order, comma-separated provider ids, e.g.
#   ZEESH_SERVER_ROUTING=groq,nvidia,gemini,minimax

# GRACE backend the CLI logs in to and reports usage to. Defaults to the
# deployed production backend (https://zeesh-ai.vercel.app). Set it to
# http://localhost:8787 ONLY for local development (npm run serve). The CLI
# only ever sends its own session token, never provider keys or DATABASE_URL.
ZEESH_API_URL=

# =========================== Backend / API (Milestones 10–12) ==============
# Neon PostgreSQL connection string — server-side only, from
# https://console.neon.tech → Connection Details. Starts with postgresql://
# Required for real auth (users/sessions tables) and usage recording.
# Set it here ONLY for the local dev server (npm run serve). It is never read
# by the CLI; the deployed backend reads it from the Vercel environment.
DATABASE_URL=

# Closed beta access (Milestone 12). Defaults to 'open' (anyone can register).
# Set to 'closed' to require an allowlist email for registration:
ZEESH_BETA_MODE=
# Comma-separated email allowlist used when ZEESH_BETA_MODE=closed, e.g.
#   ZEESH_BETA_ALLOWLIST=beta1@example.com,beta2@example.com
ZEESH_BETA_ALLOWLIST=

# CORS origin for browser clients (default '*' — the CLI is not a browser and
# is unaffected). Set to your dashboard origin in production, e.g. https://app.example.com
ZEESH_CORS_ORIGIN=

# Optional rate-limit tuning (server-side). Defaults shown.
# ZEESH_AUTH_RATE_LIMIT_MAX=50   # auth attempts / 15 min per IP
# ZEESH_API_RATE_LIMIT_MAX=300   # API requests / 1 min per IP

# ===================== GRACE FREE quota (Milestone 13) =====================
# Server-side free-tier quota for /api/provider. Defaults shown. The day
# boundary is 00:00 UTC. (Renamed limits below are respected if set.)
# ZEESH_SESSIONS_PER_DAY=3        # sessions per user per day (3h/day max)
# ZEESH_SESSION_DURATION_MINUTES=60  # minutes per session

# ============== Internal cost protection (Milestone 18) ====================
# INTERNAL safety ceilings — never shown to users. All enforcement is
# server-side (src/api/costGuard.ts, tables in db/migrations/005_cost_guard.sql).
#
# Per-user daily ceiling in INR. Default ₹20 — the hard internal cost cap for
# hosted inference per user per UTC day. Set 0 to disable (not recommended).
# ZEESH_DAILY_COST_LIMIT_INR=20
#
# INR → USD rate used to convert the ceiling into USD microdollars.
# ZEESH_INR_PER_USD=83
#
# Global (cross-user) hosted spending circuit breakers, in INR. 0 = disabled.
# When a limit is reached, paid hosted requests are refused with a clean,
# generic message until the period rolls over.
# ZEESH_GLOBAL_DAILY_COST_LIMIT_INR=0
# ZEESH_GLOBAL_MONTHLY_COST_LIMIT_INR=0
#
# Model pricing overrides (optional). JSON keyed by "provider/model" with
# input/output/cached prices per 1M tokens (USD) and optional contextTiers,
# e.g.:
#   ZEESH_PRICING_JSON={"minimax/MiniMax-M3":{"input":0.3,"output":1.2,"cached":0.06}}
# Prices not overridden use src/costs/pricing.ts defaults.

# ===================== Sponsorships (optional, disabled by default) ========
# Ads are NOT implemented. This is a clean optional abstraction, off unless
# explicitly enabled. Sponsors are static operator-authored text only — never
# source code, files or user data. See src/ads/sponsor.ts.
# ZEESH_SPONSOR_ENABLED=false
# ZEESH_SPONSOR_MESSAGES=[{"id":"cloud","text":"Sponsored: ..."}]
# ZEESH_SPONSOR_MAX_PER_RUN=1
# ZEESH_SPONSOR_MAX_PER_DAY=3

# =========================== Serverless / runtime ==========================
# Vercel and Neon expose their own tuning; nothing else is required.
# PORT is only read by the local dev server (npm run serve).
# PORT=8787
